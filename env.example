# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-site-name.netlify.app
NEXT_PUBLIC_SITE_NAME=bacco

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Contact Form (Optional - if using Netlify Forms)
NETLIFY_FORM_ID=contact-form

# Social Media (Optional)
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/bacco
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/bacco
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/bacco

# Google Maps (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
